# ============================================================
# BeeMarketBot: configuración
# Copia este archivo como .env y completa los valores.
# Todas las APIs de modelos usan el formato de OpenAI, que admiten
# muchos proveedores distintos.
# ============================================================

# ---------- Modelo de lenguaje (obligatorio) ----------
# Lo usan la ontología y la simulación y, salvo que indiques lo contrario
# abajo, también la memoria en grafos.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ---------- Memoria en grafos: base de grafos (obligatorio) ----------
# Motor propio sobre Graphiti: no necesita ningún servicio externo de memoria,
# solo una base de grafos accesible. FalkorDB (recomendado) o Neo4j:
#   falkordb://host:6379
#   falkordb://host:6379/nombre_de_la_base
#   neo4j://usuario:clave@host:7687/nombre_de_la_base
GRAPH_DB_URL=falkordb://localhost:6379

# Frecuencia con que el worker revisa la cola durable (segundos).
GRAPHRAG_POLL_INTERVAL=1
# Segundos sin avance del bucle del worker antes de reiniciarse solo (900 por defecto).

# ---------- Memoria en grafos: embeddings (obligatorio) ----------
# Modelo que convierte el texto en vectores, y tamaño de esos vectores.
# Cada proveedor usa nombres propios: text-embedding-v3 y 1024 para Alibaba
# (el mismo proveedor del ejemplo de arriba), bge_m3_embed y 1024 para Kimi,
# text-embedding-3-small y 1536 para OpenAI.
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# Si el proveedor de LLM_* también ofrece embeddings, deja estas dos variables
# sin definir para usar ese proveedor y esa misma clave:
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---------- Memoria en grafos: modelo de extracción (opcional) ----------
# Por defecto el grafo usa el mismo modelo y la misma clave que LLM_*.
# GRAPH_LLM_API_KEY=
# GRAPH_LLM_BASE_URL=
# GRAPH_LLM_MODEL=
# GRAPH_LLM_STRUCTURED_OUTPUT=json_schema    # o json_object si el modelo no acepta json_schema

# ---------- Ajuste fino (opcional) ----------
# GRAPH_LLM_THINKING=auto              # auto, disabled, enabled u omit (revisa GRAPH_LLM_TEMPERATURE si lo cambias)
# GRAPH_LLM_TEMPERATURE=0.6
# GRAPH_INGESTION_WINDOW=8             # fragmentos que se procesan juntos
# GRAPH_LLM_CONCURRENCY=5              # llamadas simultáneas al modelo
# GRAPH_DB_MAX_CONCURRENT_QUERIES=0    # 0: se calcula según los hilos de FalkorDB
# GRAPH_STATE_DIR=                     # dónde se guarda el estado de los lotes

# ---------- Compatibilidad del modelo (opcional) ----------
# Algunos proveedores solo aceptan ciertos valores de temperatura, o esperan
# parámetros propios. Si defines estas variables, se aplican a todas las
# llamadas de la aplicación al modelo:
# LLM_TEMPERATURE=0.6                                  # reemplaza la temperatura de cada llamada
# LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'  # parámetros extra de cada llamada
# Ejemplo con Kimi (kimi-for-coding): con el razonamiento desactivado solo admite
# temperatura 0.6; con el razonamiento activado solo admite 1.0.

# ---------- Modelo acelerado (opcional) ----------
# Si no lo usas, deja estas tres variables fuera de tu archivo .env.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ---------- Acceso de usuarios ----------
# Obligatorio en un servidor: firma las sesiones. Sin ella se genera una al
# arrancar y todas las sesiones se cierran en cada reinicio. Genera una con:
#   openssl rand -hex 32
# No dejes el valor de ejemplo: si empieza por "change_me" se ignora.
SECRET_KEY=change_me_to_a_random_value

# Primer administrador (opcional): solo se crea si todavía no hay ninguna
# cuenta, y tendrá que cambiar la contraseña la primera vez que entre. La
# alternativa, y la que se usa después, es crear las cuentas con un comando
# (la pantalla de entrada lo muestra cuando no hay cuentas):
#   docker compose exec -T beemarketbot-api sh -c 'cd backend && uv run --frozen python -m app.auth create-user --username <nombre> --role admin --generate-password'
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me_to_a_strong_password

# COOKIE_SECURE=true        # si la aplicación se sirve por HTTPS
# SESSION_HOURS=168         # horas antes de que caduque la sesión (7 días)
# CORS_ORIGINS=https://otro-origen    # páginas ajenas a esta interfaz que pueden llamar a la API, separadas por comas
